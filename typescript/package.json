{
  "name": "time-deposit-kata-node",
  "version": "1.0.0",
  "description": "",
  "author": "Sohail Yar Khan (Ikigai)",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "ts-node src/main.ts",
    "start:prod": "node dist/main.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest --runInBand",
    "generate:api": "openapi-typescript api/openapi.yaml -o src/adapter/in/http/generated/openapi.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/adapter/out/persistence/dataSource.ts",
    "migration:run": "yarn typeorm migration:run",
    "migration:generate": "yarn typeorm migration:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.9",
    "@testcontainers/postgresql": "^11.8.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.3.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.20",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "keywords": [],
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "yaml": "^2.8.1"
  }
}
